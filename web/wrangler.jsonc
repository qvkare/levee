// The public site at leveefi.xyz: the Next.js app and /api/risk on Cloudflare Workers, built by OpenNext.
// Deploy with `pnpm --filter web run deploy` (needs `wrangler login`). `pnpm deploy` alone is a pnpm command.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levee",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // OpenNext calls back into its own Worker. The service name must match the Worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "levee" }
  ],
  // Reads per address per minute. Free on every plan. Counted per Cloudflare location, so it slows a burst and is not an exact quota.
  "ratelimits": [{ "name": "RISK_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "workers_dev": false,
  // leveefi.xyz is the address. levee.qvkare.com stays so earlier links keep working.
  "routes": [
    { "pattern": "leveefi.xyz", "custom_domain": true },
    { "pattern": "levee.qvkare.com", "custom_domain": true }
  ]
}
