# Optional. Comma-separated mainnet RPC URLs, tried in order before the public fallbacks.
# These names differ from the keeper's BASE_RPC_URLS on purpose: the keeper may point at a testnet.
# URLs can hold API keys. They stay on the server and are not sent in responses.
RISK_BASE_RPC_URLS=
RISK_ARBITRUM_RPC_URLS=

# Set to "off" to use only the URLs above, with no public fallback.
RISK_PUBLIC_RPC_FALLBACK=

# Optional. Defaults to the public Hyperliquid info endpoint.
RISK_HYPERLIQUID_INFO_URL=

# Optional. Where /proof reads run records at build time. Defaults to ../evidence/runs.
LEVEE_EVIDENCE_DIR=
