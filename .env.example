# Never commit real values.
NEAR_NETWORK=testnet
# Optional. Defaults to a public endpoint for NEAR_NETWORK.
NEAR_RPC_URL=
LEVEE_CONTRACT=
KEEPER_ACCOUNT=
# Function-call key limited to `rescue` on LEVEE_CONTRACT.
KEEPER_PRIVATE_KEY=
# Positions file, relative to the repo root. See keeper/positions.example.json.
KEEPER_CONFIG=keeper/positions.json
# Comma separated. The keeper needs at least two endpoints per chain.
BASE_RPC_URLS=https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com
ARBITRUM_RPC_URLS=https://sepolia-rollup.arbitrum.io/rpc,https://arbitrum-sepolia-rpc.publicnode.com
# Fork tests only. Read-only, and each must serve state at the block pinned in evm/.
BASE_FORK_RPC_URL=https://mainnet.base.org
ARBITRUM_FORK_RPC_URL=https://arbitrum-one.public.blastapi.io
# Reserve layer, set after partner access is granted.
INTENTS_PARTNER_KEY=
