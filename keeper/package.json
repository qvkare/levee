{
  "name": "keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Levee keeper: watches health factors, asks the contract to sign a repay and broadcasts it.",
  "engines": {
    "node": ">=22.22.2"
  },
  "bin": {
    "keeper": "./dist/cli.js"
  },
  "scripts": {
    "keeper": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.live.test.ts' --exclude '**/*.fork.test.ts'",
    "test:live": "vitest run test/derive.live.test.ts",
    "test:e2e": "vitest run test/e2e.fork.test.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.2.0",
    "near-api-js": "7.4.0",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
